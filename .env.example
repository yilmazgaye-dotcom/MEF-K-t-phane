# Bu dosya yalnızca örnektir. Gerçek değerleri Vercel > Project > Settings > Environment Variables
# bölümüne girin. Yerelde denemek için bu dosyayı .env.local olarak kopyalayın (git'e girmez).

# ZORUNLU: OpenAI API anahtarı (yalnızca sunucuda kullanılır, tarayıcıya hiçbir zaman gönderilmez)
OPENAI_API_KEY=

# Model ve yanıt ayarları (isteğe bağlı)
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1500

# API'yi kendi alan adı dışında doğrudan çağırmasına izin verilecek siteler (virgülle ayırın).
# Widget iframe ile çalıştığı için normalde BOŞ bırakılır.
ALLOWED_ORIGINS=

# IP başına istek sınırı (sunucu örneği başına, en iyi çaba). Asıl sınır için Vercel Firewall kuralı önerilir.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=300

# Crossref "polite pool" için kurumsal iletişim adresi (isteğe bağlı, örn. kütüphanenin genel adresi)
CROSSREF_MAILTO=
